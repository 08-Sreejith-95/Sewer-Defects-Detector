# Dockerfile.api
# FastAPI live inference service for Sewer Defect Detector
# Build:  docker build -f Dockerfile.api -t sewer-defect-api .
# Run:    docker run -p 8000:8000 -v $(pwd)/models:/app/models sewer-defect-api

FROM python:3.11-slim

WORKDIR /app

# System dependencies required by OpenCV / ONNX Runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies first for better layer caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Config path can be overridden at runtime with -e CONFIG_PATH=...
ENV CONFIG_PATH=configs/configs.yaml

# Expose the port uvicorn will listen on
EXPOSE 8000

# Basic container-level health check, hits the FastAPI /health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Run the FastAPI app with uvicorn
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
